{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Talenta: jalankan & buka web",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Talenta: cek Node.js 24+",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "env": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "TALENTA_OPEN_BROWSER": "false"
      },
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Alamat web: (http://localhost:[0-9]+/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
